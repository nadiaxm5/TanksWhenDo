    "SunColor": [255, 238, 182],
    "SunAmbientColor": [170, 180, 200],
    "Cast": [
        {
            "Name": "LevelArt",
            "Prefab": "LevelArt"
        },
        {
            "Name": "BlueTank",
            "Prefab": "BlueTank",
            "Tag":"PlayerBlue",
            "Position": [-3.0, 0.0, 30.0],
            "Rotation": [0.0, 180.0, 0.0],
            "Properties": ["speed=5", "angularSpeed=90"],
            "Script": [
                {
                    "When": ["Keyboard(D,Press)"],
                    "Do": ["Rotate(this.angularSpeed, this.x, this.y, this.z)"]
                },
                {
                    "When": ["Keyboard(A,Press)"],
                    "Do": ["Rotate(-this.angularSpeed, this.x, this.y, this.z)"]
                },
                {
                    "When": ["Keyboard(W,Press)"],
                    "Do": ["Move(this.ry,this.speed)"]
                },
                {
                    "When": ["Keyboard(S,Press)"],
                    "Do": ["Move(this.ry+180,this.speed)"]
                }
            ]
        },
        {
            "Name": "RedTank",
            "Prefab": "RedTank",
            "Tag":"PlayerRed",
            "Position": [13.0, 0.0, -5.0],
            "Rotation": [0.0, 0.0, 0.0],
            "Properties": ["speed=5", "angularSpeed=90"],
            "Script": [
                {
                    "When": ["Keyboard(RightArrow,Press)"],
                    "Do": ["Rotate(this.angularSpeed, this.x, this.y, this.z)"]
                },
                {
                    "When": ["Keyboard(LeftArrow,Press)"],
                    "Do": ["Rotate(-this.angularSpeed, this.x, this.y, this.z)"]
                },
                {
                    "When": ["Keyboard(UpArrow,Press)"],
                    "Do": ["Move(this.ry,this.speed)"]
                },
                {
                    "When": ["Keyboard(DownArrow,Press)"],
                    "Do": ["Move(this.ry+180,this.speed)"]
                }
            ]
        }
    ]
}