{
    "Name": "TANKS",
    "CameraPosition": [-12, 20, 5],
    "CameraRotation": [50, 60, 0],
    "SunPosition": [0, 10, 0],
    "SunRotation": [54.3, -26.2, 10.5],
    "SunColor": [255, 200, 100],
    "SunAmbientColor": [180, 180, 180],
    "Cast": [
        {
            "Name": "LevelArt",
            "Prefab": "LevelArt",
            "Tag":"Obstacle"
        },
        {
            "Name": "BlueTank",
            "Prefab": "BlueTank",
            "Tag":"BlueTank",
            "Position": [-3.0, 0.0, 30.0],
            "Rotation": [0.0, 180.0, 0.0],
            "Properties": ["speed=10", "angularSpeed=90", "health=100"],
            "Script": [
                {
                    "When": ["Keyboard(D,Press)"],
                    "Do": ["Rotate(this.angularSpeed, this.x, this.y, this.z)", "PlayParticles(DustTrail)"]
                },
                {
                    "When": ["Keyboard(A,Press)"],
                    "Do": ["Rotate(-this.angularSpeed, this.x, this.y, this.z)", "PlayParticles(DustTrail)"]
                },
                {
                    "When": ["Keyboard(W,Press)"],
                    "Do": ["Move(this.ry,this.speed)"]
                },
                {
                    "When": ["Keyboard(S,Press)"],
                    "Do": ["Move(this.ry+180,this.speed)"]
                },
                {
                    "When": ["Collision(Shell)"],
                    "Do": ["this.health=this.health-Shell.damage"]
                }
            ]
        },
        {
            "Name": "RedTank",
            "Prefab": "RedTank",
            "Tag":"RedTank",
            "Position": [13.0, 0.0, -5.0],
            "Rotation": [0.0, 0.0, 0.0],
            "Properties": ["speed=10", "angularSpeed=90", "health=100"],
            "Script": [
                {
                    "When": ["Keyboard(RightArrow,Press)"],
                    "Do": ["Rotate(this.angularSpeed, this.x, this.y, this.z)", "PlayParticles(DustTrail)"]
                },
                {
                    "When": ["Keyboard(LeftArrow,Press)"],
                    "Do": ["Rotate(-this.angularSpeed, this.x, this.y, this.z)", "PlayParticles(DustTrail)"]
                },
                {
                    "When": ["Keyboard(UpArrow,Press)"],
                    "Do": ["Move(this.ry,this.speed)"]
                },
                {
                    "When": ["Keyboard(DownArrow,Press)"],
                    "Do": ["Move(this.ry+180,this.speed)"]
                },
                {
                    "When": ["Collision(Shell)"],
                    "Do": ["this.health=this.health-Shell.damage"]
                }
            ]
        },
        {
            "Name": "Shell",
            "Prefab": "Shell",
            "Tag":"Shell",
            "Active": false,
            "Properties": ["speed=15", "damage=50"],
            "Script": [
                {
                    "Do": ["Move(this.ry,this.speed)"]
                },
                {
                    "When": ["Collision(BlueTank)"],
                    "Do": ["Spawn(ShellExplosion, this)", "Delete(this)"]
                },
                {
                    "When": ["Collision(RedTank)"],
                    "Do": ["Spawn(ShellExplosion, this)", "Delete(this)"]
                },
                {
                    "When": ["Collision(Obstacle)"],
                    "Do": ["Spawn(ShellExplosion, this)", "Delete(this)"]
                }
            ]
        },
        {
            "Name": "ShellExplosion",
            "Prefab": "ShellExplosion",
            "Active": false,
            "Properties": ["counter=20"],
            "Script": [
                {
                    "Do": ["this.counter=this.counter-1", "PlayParticles(ShellExplosion)", "PlaySound(ShellExplosion)"]
                },
                {
                    "When": ["this.counter<0"],
                    "Do": ["Delete(this)"]
                }
            ]
        },
        {
            "Name": "BlueBulletSpawner",
            "Prefab": "BlueBulletSpawner",
            "Position": [-3.0, 0.0, 30.0],
            "Rotation": [0.0, 180.0, 0.0],
            "Properties": ["despX=0.0", "despY=1.7", "despZ=1.35", "maxAim=200", "currentAim=0"],
            "Script": [
                {
                    "Do": ["this.x=BlueTank.x", "this.y=BlueTank.y", "this.z=BlueTank.z", "this.ry=BlueTank.ry"]
                },
                {
                    "When": ["Keyboard(Space,Press)"],
                    "Do": ["this.currentAim=this.currentAim+1", "PlaySound(ShotCharging)"]
                },
                {
                    "When": ["this.currentAim>=this.maxAim"],
                    "Do": ["this.currentAim=this.maxAim"]
                },
                {
                    "When": ["Keyboard(Space,Up)"],
                    "Do": ["Spawn(Shell, this, this.despX, this.despY, this.despZ)", "this.currentAim=0", "StopSound(ShotCharging)", "PlaySound(ShotFiring)"]
                }
            ]
        },
        {
            "Name": "RedBulletSpawner",
            "Prefab": "RedBulletSpawner",
            "Position": [-3.0, 0.0, 30.0],
            "Rotation": [0.0, 180.0, 0.0],
            "Properties": ["despX=0.0", "despY=1.7", "despZ=1.35", "maxAim=200", "currentAim=0"],
            "Script": [
                {
                    "Do": ["this.x=RedTank.x", "this.y=RedTank.y", "this.z=RedTank.z", "this.ry=RedTank.ry"]
                },
                {
                    "When": ["Keyboard(Return,Press)"],
                    "Do": ["this.currentAim=this.currentAim+1", "PlaySound(ShotCharging)"]
                },
                {
                    "When": ["this.currentAim>=this.maxAim"],
                    "Do": ["this.currentAim=this.maxAim"]
                },
                {
                    "When": ["Keyboard(Return,Up)"],
                    "Do": ["Spawn(Shell, this, this.despX, this.despY, this.despZ)", "this.currentAim=0", "StopSound(ShotCharging)", "PlaySound(ShotFiring)"]
                }
            ]
        },
        {
            "Name": "BlueAim",
            "Prefab": "BlueAim",
            "Script": [
                {
                    "Do": ["this.x=BlueTank.x", "this.y=BlueTank.y", "this.z=BlueTank.z", "this.ry=BlueTank.ry", "this.value=BlueBulletSpawner.currentAim"]
                }
            ]
        },
        {
            "Name": "RedAim",
            "Prefab": "RedAim",
            "Script": [
                {
                    "Do": ["this.x=RedTank.x", "this.y=RedTank.y", "this.z=RedTank.z", "this.ry=RedTank.ry", "this.value=RedBulletSpawner.currentAim"]
                }
            ]
        },
        {
            "Name": "RedHealth",
            "Prefab": "RedHealth",
            "Properties": ["despY=0.05"],
            "Script": [
                {
                    "Do": ["this.x=RedTank.x", "this.y=RedTank.y+this.despY", "this.z=RedTank.z", "this.ry=RedTank.ry", "this.value=RedTank.health"]
                }
            ]
        },
        {
            "Name": "BlueHealth",
            "Prefab": "BlueHealth",
            "Properties": ["despY=0.05"],
            "Script": [
                {
                    "Do": ["this.x=BlueTank.x", "this.y=BlueTank.y+this.despY", "this.z=BlueTank.z", "this.ry=BlueTank.ry", "this.value=BlueTank.health"]
                }
            ]
        }
    ]
}